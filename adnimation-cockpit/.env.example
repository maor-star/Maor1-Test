# ---- Core ----
DATABASE_URL=postgres://cockpit:cockpit@127.0.0.1:5432/cockpit
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# ---- Owner password sign-in ----
# The single account that can sign in with a password. OWNER_PASSWORD_HASH is
# produced by `npx tsx scripts/hash-password.ts '<password>'` — the password
# itself is never stored here or anywhere else in the repo.
OWNER_EMAIL=maor@adnimation.com
OWNER_PASSWORD_HASH=
OWNER_NAME=

# ---- Auth (Google Workspace SSO) ----
# Optional. The Google button only appears when both values are set.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Exactly two addresses, comma separated: owner first, then operator.
ALLOWED_EMAILS=maor@adnimation.com,mor@adnimation.com

# ---- Google service account (Drive / Gmail / Calendar) — milestone 4+ ----
GOOGLE_SERVICE_ACCOUNT_KEY=
DRIVE_CONTRACTS_ROOT_ID=

# ---- Slack ----
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CEO_USER_ID=

# ---- ClickUp ----
# Personal API token from ClickUp > Settings > Apps. The mirror only reads.
CLICKUP_API_TOKEN=
CLICKUP_TEAM_ID=90182646536
CLICKUP_WEBHOOK_SECRET=
# List that delegated tasks are created in, when the delegate form does not
# name one. Required for delegation to work at all.
CLICKUP_DEFAULT_LIST_ID=

# ---- Later milestones ----
CALENDLY_TOKEN=
ESIGN_PROVIDER=
ESIGN_API_KEY=
ESIGN_ACCOUNT_ID=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ---- Agent safety rails ----
AGENTS_GLOBAL_KILL=false
MAX_AUTO_SIGN_VALUE_USD=0

# Set to 1 to run every external integration against its in-memory fake.
USE_FAKE_INTEGRATIONS=0

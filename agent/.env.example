# העתק קובץ זה ל-agent/.env ומלא את הערכים האמיתיים.
# חשוב: agent/.env לא נשמר ב-git (ראה .gitignore).

# --- API ---
API_BASE_URL=https://dashapi.xe.works/adnimation/client
API_TOKEN=

# אימות: איך שולחים את הטוקן.
# Bearer:  API_AUTH_HEADER=Authorization  |  API_AUTH_SCHEME=Bearer
# API key: API_AUTH_HEADER=X-API-Key      |  API_AUTH_SCHEME=   (ריק)
API_AUTH_HEADER=Authorization
API_AUTH_SCHEME=Bearer

# --- התנהגות ---
API_TIMEOUT_MS=30000
API_MAX_RETRIES=3

# מצב יבש: true = לא מבצע כתיבות אמיתיות (מומלץ לריצה ראשונה).
DRY_RUN=true

# שעת ריצה יומית עבור המתזמן הפנימי (agent/scheduler.js), פורמט HH:MM.
DAILY_RUN_AT=08:00

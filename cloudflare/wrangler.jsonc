{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "office-app",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",

  // הקבצים הסטטיים מגיעים מאותה תיקיית public של האפליקציה המקורית —
  // אין עותק כפול, אין סנכרון לתחזק.
  // run_worker_first: כל בקשה עוברת קודם דרך ה-Worker, כדי שגם דפים סטטיים
  // ידרשו סיסמה ולא רק ה-API.
  "assets": {
    "directory": "../public",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "office-app-db",
      // מתמלא אוטומטית על ידי `npm run db:create` — אל תמציא ערך.
      "database_id": "REPLACE_AFTER_db:create"
    }
  ],

  "observability": {
    "enabled": true
  }
}
